# Copy this file to .env and fill only the providers you plan to run.

# Participant model providers
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Vertex AI judge configuration for canonical GEMBA-MQM-style judging
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini participant backend: api or vertex
GEMINI_TRANSLATION_BACKEND=api
