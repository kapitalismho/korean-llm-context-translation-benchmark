# Copy this file to .env and fill only the providers you plan to run.

# Participant model providers
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Papago unofficial web translator (no API key required; POSTs to
# papago.naver.com/api/text/translation like the live web app).
# Requires Python 3.10+ with: pip install -r scripts/papago-bridge-requirements.txt
# PAPAGO_PYTHON=python
# PAPAGO_BRIDGE_PATH=scripts/papago-bridge.py
# PAPAGO_WORK_DIR=output/papago
# PAPAGO_CLIENT_TIMEOUT_MS=90000
# PAPAGO_API_URL=https://papago.naver.com/api/text/translation
# PAPAGO_MIN_INTERVAL_MS=10000
# PAPAGO_JITTER_MS=20000
# PAPAGO_REQUEST_TIMEOUT_MS=30000
# PAPAGO_CACHE_SIZE=1024
# PAPAGO_BASE_COOLDOWN_MS=30000
# PAPAGO_AUTH_COOLDOWN_MS=60000
# PAPAGO_MAX_COOLDOWN_MS=300000

# Vertex AI judge configuration for canonical GEMBA-MQM-style judging
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini participant backend: api or vertex
GEMINI_TRANSLATION_BACKEND=api

# OpenRouter batch judge overrides (test/debug hooks; leave unset in production)
# OPENROUTER_BATCH_API_BASE_URL=https://openrouter.ai/api
# OPENROUTER_BATCH_POLL_INTERVAL_MS=15000
